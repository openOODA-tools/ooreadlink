# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooreadlink-bin
_pkgname=ooreadlink
pkgver=0.1.0
pkgrel=1
pkgdesc="Resolves symbolic link targets and canonicalizes path sequences without traversal."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooreadlink"
license=('Apache-2.0')
depends=('glibc')
provides=('ooreadlink')
conflicts=('ooreadlink')
source_x86_64=("${url}/releases/download/v${pkgver}/ooreadlink-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooreadlink-linux-x86_64" "${pkgdir}/usr/bin/ooreadlink"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooreadlink-uninstall"
}
